meta {
  name: 1. Registro de Usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "Persona Dos",
    "email": "p2@academica.test",
    "password": "Password123!",
    "rol": "administrador",
    "roles": ["administrador"],
    "permissions": ["estudiantes.crear"]
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Token is generated", function() {
    expect(res.getBody().token).to.be.a('string');
  });
}
