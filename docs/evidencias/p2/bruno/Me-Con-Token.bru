meta {
  name: 4. Me Con Token
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("User email is correct", function() {
    expect(res.getBody().email).to.equal("p2@academica.test");
  });
}
