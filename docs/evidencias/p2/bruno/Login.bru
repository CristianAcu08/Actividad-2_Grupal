tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Token is returned", function() {
    expect(res.getBody().token).to.be.a('string');
    bru.setEnvVar("token", res.getBody().token);
  });
}
