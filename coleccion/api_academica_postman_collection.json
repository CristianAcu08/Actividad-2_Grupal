      "item": [
        {
          "name": "01. Register - Registro público anti-escalada (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Token emitido en registro', function () {",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('token', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Prueba Registro\",\n  \"email\": \"nuevo.usuario@academica.test\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"rol\": \"administrador\",\n  \"roles\": [\"administrador\"],\n  \"permissions\": [\"estudiantes.crear\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            }
          }
        },
