meta {
  name: 05. Crear Estudiante Admin RBAC (201)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/estudiantes
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "user_id": 7,
    "carrera_id": 1,
    "cedula": "3-3333-3333",
    "nombre": "Carlos",
    "apellido": "Ejemplo",
    "correo_institucional": "carlos@estudiantes.test",
    "activo": true
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
